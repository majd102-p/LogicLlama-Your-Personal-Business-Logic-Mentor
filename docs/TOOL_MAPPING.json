{
  "version": "1.8.0",
  "description": "LogicLlama Autonomous Pentesting Agent - Enterprise-Grade Engine with Safety, Governance, and Causal Reasoning",
  "safety_layer": {
    "scope_validation_required": true,
    "allow_external_targets": false,
    "rate_limit_enforcement": true,
    "destructive_actions_blocked": true,
    "human_confirmation_required": [
      "mass_parallel_execution",
      "destructive_payload",
      "credential_operations"
    ]
  },
  "resource_governance": {
    "max_requests_per_minute": 500,
    "memory_limit_mb": 2048,
    "max_active_sessions": 10,
    "auto_cleanup": true
  },
  "execution_engine": {
    "auto_traverse_graph": true,
    "max_graph_depth": 5,
    "learning_update_trigger": "on_tool_completion",
    "halt_conditions": [
      "critical_vulnerability_confirmed",
      "max_depth_reached",
      "safety_violation_detected"
    ],
    "branch_control": {
      "max_total_nodes": 50,
      "max_branch_depth": 4,
      "branch_decay_factor": 0.15,
      "priority_recalculation_interval": 2
    },
    "runtime_behavior": {
      "strategy": "priority_queue",
      "parallel_execution_allowed": true,
      "max_concurrent_branches": 3,
      "recovery_logic": {
        "on_branch_failure": "rollback_state",
        "tool_blacklist_threshold": 3,
        "max_retries_per_node": 2
      }
    }
  },
  "decision_engine": {
    "scoring_formula": "final_score = base_score + sum(matched_rule_weights) + memory_bias_score + (success_weight_boost * success_count) - (failure_penalty * failure_count)",
    "normalization": "min-max",
    "selection_config": {
      "top_k": 2,
      "tie_breaker": "highest_base_score | lowest_complexity | random"
    },
    "memory_bias": {
      "enabled": true,
      "pattern_match_boost": 0.15,
      "historical_failure_penalty": 0.10
    },
    "feedback_model": {
      "type": "per_tool",
      "success_counter_field": "success_count",
      "failure_counter_field": "failure_count"
    },
    "learning_model": {
      "type": "bounded",
      "success_weight_boost": 0.05,
      "failure_penalty": 0.03,
      "max_adjustment": 0.2,
      "decay_rate": 0.01
    },
    "confidence_model": {
      "method": "rule_coverage",
      "formula": "matched_rules / total_rules",
      "integration": {
        "affects_tool_ranking": true,
        "affects_phase_transition": true,
        "stopping_condition_threshold": 0.9,
        "low_probability_pruning_threshold": 0.15
      }
    },
    "explainability": {
      "include_rule_matches": true,
      "include_score_breakdown": true,
      "include_memory_influence": true
    }
  },
  "state_engine": {
    "attack_state_schema": {
      "phase": "recon | probing | exploitation | validation",
      "current_step": "string",
      "completed_steps": [
        "string"
      ],
      "artifacts": [
        {
          "type": "http_response | token | payload | session_id",
          "endpoint": "string",
          "status_code": "number",
          "data_hash": "string",
          "extracted_value": "string"
        }
      ],
      "discovered_signals": [
        "string"
      ]
    },
    "evidence_graph": {
      "nodes": [],
      "edges": [],
      "causality_tracking": true
    },
    "transition_rules": [
      {
        "from_phase": "recon",
        "required_signals": [
          "endpoint_discovered",
          "parameters_mapped"
        ],
        "to_phase": "probing"
      },
      {
        "from_phase": "probing",
        "required_signals": [
          "anomaly_detected"
        ],
        "to_phase": "exploitation"
      },
      {
        "from_phase": "exploitation",
        "required_signals": [
          "exploit_success",
          "artifact_generated"
        ],
        "to_phase": "validation"
      }
    ],
    "hypothesis_schema": {
      "id": "string",
      "description": "string",
      "status": "created | active | confirmed | discarded",
      "confidence": "number",
      "supporting_signals": [
        "string"
      ],
      "lifecycle_rules": {
        "on_signal_match": "confidence += 0.2",
        "on_signal_conflict": "confidence -= 0.15",
        "confirm_threshold": 0.8,
        "discard_threshold": 0.2
      }
    },
    "long_term_memory": {
      "successful_patterns": [
        "string"
      ],
      "failed_patterns": [
        "string"
      ],
      "cross_session_insights": [
        "string"
      ]
    }
  },
  "signal_engine": {
    "vulnerability_confidence_model": {
      "initial_confidence": 0.1,
      "signal_weight_multiplier": 0.2,
      "signal_correlation_handling": {
        "enabled": true,
        "deduplicate_correlated_signals": true,
        "max_confidence_per_category": 0.4
      }
    },
    "extraction_logic": {
      "response_length_diff": {
        "field": "response_body_length_diff",
        "operator": ">",
        "value": 20
      },
      "latency_spike": {
        "field": "response_time_ms",
        "operator": ">",
        "value": {
          "type": "expression",
          "formula": "baseline_latency_ms * 1.5"
        }
      },
      "unexpected_state": {
        "logical_and": [
          {
            "field": "response.status_code",
            "operator": "==",
            "value": 200
          },
          {
            "field": "response.body",
            "operator": "contains",
            "value": "success"
          },
          {
            "field": "prerequisite_step_skipped",
            "operator": "==",
            "value": true
          }
        ]
      },
      "duplicate_transaction": {
        "field": "transaction_count_for_user",
        "operator": ">",
        "value": {
          "type": "reference",
          "field": "initial_transaction_count"
        }
      }
    },
    "defined_signals": [
      {
        "name": "response_length_diff",
        "type": "boolean",
        "effects": [
          {
            "target": "CWE-639",
            "action": "increase_confidence",
            "value": 0.25
          },
          {
            "target": "CWE-285",
            "action": "trigger_auth_bypass_check",
            "value": 0.10
          }
        ]
      },
      {
        "name": "latency_spike",
        "type": "boolean",
        "effects": [
          {
            "target": "CWE-362",
            "action": "increase_confidence",
            "value": 0.30
          },
          {
            "target": "CWE-400",
            "action": "trigger_dos_check",
            "value": 0.15
          }
        ]
      },
      {
        "name": "unexpected_state",
        "type": "boolean",
        "effects": [
          {
            "target": "CWE-840",
            "action": "increase_confidence",
            "value": 0.35
          }
        ]
      },
      {
        "name": "duplicate_transaction",
        "type": "boolean",
        "effects": [
          {
            "target": "CWE-837",
            "action": "confirm_vulnerability",
            "value": 1.0
          }
        ]
      }
    ]
  },
